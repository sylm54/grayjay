{
  "name": "grayjay-devkit",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo for developing Grayjay plugins: typesafe runtime library, bundler, signer, tester and CLI.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*",
    "plugins/*"
  ],
  "scripts": {
    "check": "tsc --build",
    "test": "bun test packages examples",
    "example:build": "cd examples/feed-demo && bunx --bun gj build --sign",
    "example:validate": "cd examples/feed-demo && bunx --bun gj validate"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.6.0"
  }
}
